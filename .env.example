# =========================================================================
#  Goa Voice-RAG — environment configuration
#  Copy to `.env` and fill in. Everything has a safe default so the app
#  runs in MOCK mode with zero keys for local development / demos.
# =========================================================================

# ---- Speech-to-Text (REQUIRED by the task: Sarvam or ElevenLabs) --------
STT_PROVIDER=sarvam                 # sarvam | mock
SARVAM_API_KEY=                     # get from https://dashboard.sarvam.ai
SARVAM_STT_MODEL=saarika:v2         # Sarvam ASR model
SARVAM_STT_LANGUAGE=unknown         # unknown = auto-detect; or hi-IN, en-IN, ta-IN, ...

# ---- Answer generation (provider-agnostic) ------------------------------
LLM_PROVIDER=grok                   # grok | anthropic | openai | extractive | mock
LLM_MODEL=grok-3                    # grok-3 / grok-4 | claude-sonnet-4-... | gpt-4o-mini
LLM_TEMPERATURE=0.1

# Grok / xAI  (OpenAI-compatible)
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1

# Anthropic (optional)
ANTHROPIC_API_KEY=

# OpenAI (optional)
OPENAI_API_KEY=

# ---- Retrieval ----------------------------------------------------------
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2   # local ONNX, 384-dim, 50+ langs (Indic-friendly)
INDEX_DIR=data/index
TOP_K=5                             # candidates pulled from the vector store
RERANK_TOP_N=3                      # kept after reranking / passed to the LLM

# ---- Guardrails ---------------------------------------------------------
MIN_RETRIEVAL_SCORE=0.45            # below this -> "I don't have that in my knowledge base"
GROUNDEDNESS_THRESHOLD=0.35         # answer-vs-context support floor
ENABLE_LLM_GROUNDEDNESS=false       # extra LLM-based hallucination check (adds latency)

# ---- Latency ------------------------------------------------------------
RETRIEVAL_LATENCY_TARGET_MS=200     # SLA for the core retrieval pipeline
STAGE_TIMEOUT_MS=8000               # per-stage hard timeout in the harness
STAGE_RETRIES=2                     # retries per stage on transient failure

# ---- Dataset ingestion --------------------------------------------------
DATASET_NAME=ai4bharat/MSMARCO-XI
DATASET_CONFIG=default              # the dataset's only config
DATASET_SPLIT=train                 # or: validation
DATASET_FILE=validation/hinval.parquet   # small (~460MB) Indic shard; train/*.parquet are 3.7GB
MAX_PASSAGES=5000                   # cap for a fast, demo-sized index
CHUNK_STRATEGY=metadata_recursive   # fixed | recursive | semantic | sentence_window | metadata_recursive
CHUNK_SIZE=512
CHUNK_OVERLAP=64
